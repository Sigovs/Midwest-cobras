# ─── Client hand-off folder — never committed ────────────────────────────────
# 284 MB of camera masters, a 20 MB OBJ and a 16 MB SketchUp file. The folder
# name is the client's own instruction. Optimised derivatives under assets/ are
# what ship; the masters stay on disk.
donot git_from client/

# Media masters anywhere else in the tree
assets/video/_src/
assets/model/_src/
*.MOV
*.mov
*.obj
*.skp
*.mtl

# Pre-optimisation originals
.orig/

# Pipeline intermediates. dev/model-pipeline.sh keeps the un-optimised export
# next to the shipped one so a bad result can be diagnosed without re-running
# Blender — the Shelby raw is 93 MB and has no business in git.
assets/model/_raw-*.glb

# Gate artefacts are computed against a build and are not sources.
# declare.json IS a source — it states what the build committed to — so it stays.
.gates/*
!.gates/declare.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Deps & build output (none yet — here so the first person to add them doesn't forget)
node_modules/
dist/
*.log

# Browser-automation scratch
.playwright-mcp/
*-before.jpeg
*-after.jpeg

# Client masters. 48 MB of .skp / .obj / .stl — the derived glb under
# assets/model/ is what ships, and it is the only version that should be here.
cobra2/

# Model conversion scratch: downloads and the intermediate stages between
# spec-gloss and the committed asset. dev/README.md carries the commands.
glb/

# Anything the folder name already says to keep out.
donot git/
